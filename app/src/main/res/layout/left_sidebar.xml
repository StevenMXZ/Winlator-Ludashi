<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:paddingTop="0dp"
    android:paddingBottom="16dp"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <LinearLayout
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:id="@+id/BTItemPause"
        android:background="?android:attr/selectableItemBackground"
        android:clickable="true"
        android:layout_width="match_parent"
        android:layout_height="50dp">
        <ImageView
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:src="@drawable/icon_pause"
            android:layout_marginStart="16dp"
            app:tint="@color/colorAccent"/>
        <TextView
            android:textSize="16sp"
            android:textColor="#ffffff"
            android:id="@+id/TVPause"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Pause / Resume"
            android:layout_marginStart="16dp"/>
    </LinearLayout>
    <LinearLayout
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:id="@+id/BTSubKeyboard"
        android:background="?android:attr/selectableItemBackground"
        android:clickable="true"
        android:layout_width="match_parent"
        android:layout_height="50dp">
        <ImageView
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:src="@drawable/icon_keyboard"
            android:layout_marginStart="16dp"
            app:tint="@color/colorAccent"/>
        <TextView
            android:textSize="16sp"
            android:textColor="#ffffff"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Keyboard"
            android:layout_marginStart="16dp"/>
    </LinearLayout>
    <LinearLayout
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:id="@+id/BTItemInput"
        android:background="?android:attr/selectableItemBackground"
        android:clickable="true"
        android:layout_width="match_parent"
        android:layout_height="50dp">
        <ImageView
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:src="@drawable/icon_input_controls"
            android:layout_marginStart="16dp"
            app:tint="@color/colorAccent"/>
        <TextView
            android:textSize="16sp"
            android:textColor="#ffffff"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Input Controls"
            android:layout_marginStart="16dp"/>
    </LinearLayout>
    <LinearLayout
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:id="@+id/BTItemMouse"
        android:background="?android:attr/selectableItemBackground"
        android:clickable="true"
        android:layout_width="match_parent"
        android:layout_height="50dp">
        <ImageView
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:src="@drawable/icon_mouse"
            android:layout_marginStart="16dp"
            app:tint="@color/colorAccent"/>
        <TextView
            android:textSize="16sp"
            android:textColor="#ffffff"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Mouse"
            android:layout_marginStart="16dp"/>
    </LinearLayout>
    <LinearLayout
        android:orientation="vertical"
        android:id="@+id/LLSubMouse"
        android:background="#111111"
        android:paddingTop="8dp"
        android:paddingBottom="8dp"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <Switch
            android:textColor="#cccccc"
            android:id="@+id/SWRelativeMouse"
            android:layout_width="match_parent"
            android:layout_height="40dp"
            android:text="Relative Mouse"
            android:paddingStart="56dp"
            android:paddingEnd="16dp"/>
        <Switch
            android:textColor="#cccccc"
            android:id="@+id/SWDisableMouse"
            android:layout_width="match_parent"
            android:layout_height="40dp"
            android:text="Disable Mouse"
            android:paddingStart="56dp"
            android:paddingEnd="16dp"/>
    </LinearLayout>
    <LinearLayout
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:id="@+id/BTItemFPS"
        android:background="?android:attr/selectableItemBackground"
        android:clickable="true"
        android:layout_width="match_parent"
        android:layout_height="50dp">
        <ImageView
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:src="@drawable/icon_screen_effect"
            android:layout_marginStart="16dp"
            app:tint="@color/colorAccent"/>
        <TextView
            android:textSize="16sp"
            android:textColor="#ffffff"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Show FPS"
            android:layout_marginStart="16dp"/>
    </LinearLayout>
    <LinearLayout
        android:orientation="vertical"
        android:id="@+id/LLSubFPS"
        android:background="#111111"
        android:padding="16dp"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <Switch
            android:textColor="#ffffff"
            android:id="@+id/SWHudMaster"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Enable HUD"/>
        <LinearLayout
            android:orientation="horizontal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp">
            <CheckBox
                android:textSize="12sp"
                android:textColor="#cccccc"
                android:id="@+id/CBHudFps"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:checked="true"
                android:text="FPS"
                android:layout_weight="1"/>
            <CheckBox
                android:textSize="12sp"
                android:textColor="#cccccc"
                android:id="@+id/CBHudGpu"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:checked="true"
                android:text="GPU"
                android:layout_weight="1"/>
            <CheckBox
                android:textSize="12sp"
                android:textColor="#cccccc"
                android:id="@+id/CBHudCpuRam"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:checked="true"
                android:text="CPU"
                android:layout_weight="1"/>
        </LinearLayout>
        <LinearLayout
            android:orientation="horizontal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <CheckBox
                android:textSize="12sp"
                android:textColor="#cccccc"
                android:id="@+id/CBHudBattTemp"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:checked="true"
                android:text="Batt/Temp"
                android:layout_weight="1"/>
            <CheckBox
                android:textSize="12sp"
                android:textColor="#cccccc"
                android:id="@+id/CBHudGraph"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:checked="true"
                android:text="Graph"
                android:layout_weight="1"/>
            <CheckBox
                android:textSize="12sp"
                android:textColor="#cccccc"
                android:id="@+id/CBHudRenderer"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:checked="true"
                android:text="Renderer"
                android:layout_weight="1"/>
        </LinearLayout>
        <TextView
            android:textSize="12sp"
            android:textColor="#aaaaaa"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:text="HUD Size"/>
        <com.winlator.cmod.widget.SeekBar
            android:id="@+id/SBHudScale"
            android:layout_width="match_parent"
            android:layout_height="30dp"
            app:maxValue="100"
            app:minValue="0"
            app:step="1"/>
        <TextView
            android:textSize="12sp"
            android:textColor="#aaaaaa"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="5dp"
            android:text="HUD Alpha"/>
        <com.winlator.cmod.widget.SeekBar
            android:id="@+id/SBHudAlpha"
            android:layout_width="match_parent"
            android:layout_height="30dp"
            app:maxValue="100"
            app:minValue="0"
            app:step="1"/>
    </LinearLayout>
    <LinearLayout
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:id="@+id/BTItemGraphics"
        android:background="?android:attr/selectableItemBackground"
        android:clickable="true"
        android:layout_width="match_parent"
        android:layout_height="50dp">
        <ImageView
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:src="@drawable/icon_settings"
            android:layout_marginStart="16dp"
            app:tint="@color/colorAccent"/>
        <TextView
            android:textSize="16sp"
            android:textColor="#ffffff"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Graphic Engine"
            android:layout_marginStart="16dp"/>
    </LinearLayout>
    <LinearLayout
        android:orientation="vertical"
        android:id="@+id/LLSubGraphics"
        android:background="#111111"
        android:padding="16dp"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <TextView
            android:textSize="10sp"
            android:textStyle="bold"
            android:textColor="#ffffff"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="4dp"
            android:text="RENDER MODE"/>
        <Spinner
            android:id="@+id/SPRenderMode"
            android:layout_width="match_parent"
            android:layout_height="40dp"
            android:spinnerMode="dropdown"
            android:backgroundTint="#ffffff"/>
        <TextView
            android:textSize="10sp"
            android:textStyle="bold"
            android:textColor="#ff0055"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:layout_marginBottom="4dp"
            android:text="GAME FPS LIMIT"/>
        <Spinner
            android:id="@+id/SPNativeFPS"
            android:layout_width="match_parent"
            android:layout_height="40dp"
            android:backgroundTint="#ff0055"/>
        <LinearLayout
            android:orientation="vertical"
            android:id="@+id/LLStandardOptions"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="15dp">
            <TextView
                android:textSize="10sp"
                android:textStyle="bold"
                android:textColor="#00e5ff"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="SUPER RESOLUTION"/>
            <Switch
                android:textColor="#cccccc"
                android:id="@+id/SWEnableFSR"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Enable"/>
            <Spinner
                android:id="@+id/SPUpscalerMode"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:backgroundTint="#00e5ff"/>
            <TextView
                android:textSize="10sp"
                android:textColor="#aaaaaa"
                android:id="@+id/LBLSharpnessHeader"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="Sharpness Strength"/>
            <com.winlator.cmod.widget.SeekBar
                android:id="@+id/SBSharpness"
                android:layout_width="match_parent"
                android:layout_height="40dp"
                app:maxValue="100"
                app:minValue="0"
                app:step="1"/>
            <TextView
                android:textSize="10sp"
                android:textStyle="bold"
                android:textColor="#ffd700"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:text="COLOR PROFILE"/>
            <Spinner
                android:id="@+id/SPColorMode"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:backgroundTint="#ffd700"/>
        </LinearLayout>
        <LinearLayout
            android:orientation="vertical"
            android:id="@+id/LLFrameGenOptions"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="15dp">
            <TextView
                android:textSize="10sp"
                android:textStyle="bold"
                android:textColor="#39ff14"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="FRAME GENERATION"/>
            <TextView
                android:textSize="10sp"
                android:textColor="#888888"
                android:paddingBottom="5dp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Generates fake frames."/>
            <TextView
                android:textSize="10sp"
                android:textColor="#aaaaaa"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Generation Strategy"/>
            <Spinner
                android:id="@+id/SPFrameGenFPS"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:backgroundTint="#39ff14"/>
        </LinearLayout>
        <LinearLayout
            android:orientation="vertical"
            android:id="@+id/LLNativeOptions"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="15dp">
            <TextView
                android:textSize="10sp"
                android:textStyle="bold"
                android:textColor="#ff0055"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="DIRECT RENDERING+"/>
            <TextView
                android:textSize="10sp"
                android:textColor="#888888"
                android:paddingBottom="5dp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Bypasses composition for lowest latency (only fullscreen apps)"/>
        </LinearLayout>
    </LinearLayout>
    <LinearLayout
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:id="@+id/BTItemScreen"
        android:background="?android:attr/selectableItemBackground"
        android:clickable="true"
        android:layout_width="match_parent"
        android:layout_height="50dp">
        <ImageView
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:src="@drawable/icon_screen_effect"
            android:layout_marginStart="16dp"
            app:tint="@color/colorAccent"/>
        <TextView
            android:textSize="16sp"
            android:textColor="#ffffff"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Screen"
            android:layout_marginStart="16dp"/>
    </LinearLayout>
    <LinearLayout
        android:orientation="vertical"
        android:id="@+id/LLSubScreen"
        android:background="#111111"
        android:paddingTop="8dp"
        android:paddingBottom="8dp"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <LinearLayout
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:id="@+id/BTItemPipMode"
            android:background="?android:attr/selectableItemBackground"
            android:clickable="true"
            android:layout_width="match_parent"
            android:layout_height="50dp">
            <ImageView
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:src="@drawable/ic_picture_in_picture_alt"
                android:layout_marginStart="16dp"
                app:tint="@color/colorAccent"/>
            <TextView
                android:textSize="14sp"
                android:textColor="#cccccc"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="PiP Mode"
                android:layout_marginStart="16dp"/>
        </LinearLayout>
        <LinearLayout
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:id="@+id/BTItemToggleFullscreen"
            android:background="?android:attr/selectableItemBackground"
            android:clickable="true"
            android:layout_width="match_parent"
            android:layout_height="50dp">
            <ImageView
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:src="@drawable/icon_fullscreen"
                android:layout_marginStart="16dp"
                app:tint="@color/colorAccent"/>
            <TextView
                android:textSize="14sp"
                android:textColor="#cccccc"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Toggle Fullscreen"
                android:layout_marginStart="16dp"/>
        </LinearLayout>
        <LinearLayout
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:id="@+id/BTItemMagnifier"
            android:background="?android:attr/selectableItemBackground"
            android:clickable="true"
            android:layout_width="match_parent"
            android:layout_height="50dp">
            <ImageView
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:src="@android:drawable/ic_menu_zoom"
                android:layout_marginStart="16dp"
                app:tint="@color/colorAccent"/>
            <TextView
                android:textSize="14sp"
                android:textColor="#cccccc"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Magnifier"
                android:layout_marginStart="16dp"/>
        </LinearLayout>
    </LinearLayout>
    <LinearLayout
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:id="@+id/BTItemTaskManager"
        android:background="?android:attr/selectableItemBackground"
        android:clickable="true"
        android:layout_width="match_parent"
        android:layout_height="50dp">
        <ImageView
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:src="@drawable/icon_task_manager"
            android:layout_marginStart="16dp"
            app:tint="@color/colorAccent"/>
        <TextView
            android:textSize="16sp"
            android:textColor="#ffffff"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Task Manager"
            android:layout_marginStart="16dp"/>
    </LinearLayout>
    <LinearLayout
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:id="@+id/BTItemLogs"
        android:background="?android:attr/selectableItemBackground"
        android:clickable="true"
        android:layout_width="match_parent"
        android:layout_height="50dp">
        <ImageView
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:layout_marginStart="16dp"
            app:tint="@color/colorAccent"/>
        <TextView
            android:textSize="16sp"
            android:textColor="#ffffff"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Logs"
            android:layout_marginStart="16dp"/>
    </LinearLayout>
    <LinearLayout
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:id="@+id/BTItemExit"
        android:background="?android:attr/selectableItemBackground"
        android:clickable="true"
        android:layout_width="match_parent"
        android:layout_height="50dp">
        <ImageView
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:src="@drawable/icon_exit"
            android:layout_marginStart="16dp"
            app:tint="@color/colorAccent"/>
        <TextView
            android:textSize="16sp"
            android:textColor="#ffffff"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Exit"
            android:layout_marginStart="16dp"/>
    </LinearLayout>
</LinearLayout>
