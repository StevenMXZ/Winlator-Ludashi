<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
	android:layout_width="300dp"
	android:layout_height="wrap_content"
	android:orientation="vertical">

	<TextView
		android:layout_width="wrap_content"
		android:layout_height="wrap_content"
		android:text="API"
		android:textAppearance="?android:attr/textAppearanceMedium"
		android:paddingBottom="8dp" />

	<Spinner
		style="@style/ComboBox"
		android:layout_width="match_parent"
		android:layout_height="wrap_content"
		android:entries="@array/audio_api_entries"
		android:id="@+id/SAudioApi"
		android:spinnerMode="dialog" />
    
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:id="@+id/LLBufferSize">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="8dp">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Buffer Size"/>

            <TextView
                android:id="@+id/TVBufferSize"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content" />
        </LinearLayout>

        <SeekBar
            android:id="@+id/SBBufferSize"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:min="0"
            android:max="65536" />  
    </LinearLayout>      
    
    
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:id="@+id/LLatency">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="8dp">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Latency"/>

            <TextView
                android:id="@+id/TVLatency"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content" />
        </LinearLayout>

        <SeekBar
            android:id="@+id/SBLatency"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:min="0"
            android:max="120" />  
    </LinearLayout>              

</LinearLayout>
