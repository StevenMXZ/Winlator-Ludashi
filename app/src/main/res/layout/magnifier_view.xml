<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:gravity="center"
    android:orientation="vertical"
    android:background="@drawable/content_dialog_background"
    android:paddingTop="16dp"
    android:paddingBottom="16dp"
    android:layout_width="68dp"
    android:layout_height="wrap_content">
    <ImageButton
        android:id="@+id/BTMove"
        android:layout_marginBottom="4dp"
        android:src="@drawable/icon_move"
        style="@style/ListMenuButton"/>
    <ImageButton
        android:id="@+id/BTHide"
        android:src="@drawable/icon_hide"
        style="@style/ListMenuButton"/>
    <View style="@style/HorizontalLine"/>
    <ImageButton
        android:id="@+id/BTZoomPlus"
        android:layout_marginBottom="4dp"
        android:src="@drawable/icon_zoom_plus"
        style="@style/ListMenuButton"/>
    <TextView
        android:id="@+id/TextView"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="4dp"/>
    <ImageButton
        android:id="@+id/BTZoomMinus"
        android:src="@drawable/icon_zoom_minus"
        style="@style/ListMenuButton"/>
</LinearLayout>
